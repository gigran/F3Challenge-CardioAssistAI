# Detecta automaticamente arquivos de texto.
* text=auto

# Código-fonte, documentação e configurações multiplataforma.
*.py text eol=lf
*.md text eol=lf
*.txt text eol=lf
*.toml text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.json text eol=lf
*.sql text eol=lf
*.sh text eol=lf
.env.example text eol=lf
Dockerfile text eol=lf

# Scripts executados diretamente no Windows.
*.ps1 text eol=crlf
*.bat text eol=crlf
*.cmd text eol=crlf

# Arquivos binários não devem sofrer conversão de final de linha.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary
*.zip binary
*.gguf binary
*.safetensors binary