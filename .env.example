# Aplicação
APP_NAME="CardioAssist AI"
APP_ENV="development"
APP_HOST="127.0.0.1"
APP_PORT=8000

# Provedor da LLM: ollama ou openai
LLM_PROVIDER="ollama"

# Ollama - opção local e gratuita
OLLAMA_BASE_URL="http://localhost:11434"
OLLAMA_CHAT_MODEL="qwen3:1.7b"
OLLAMA_EMBEDDING_MODEL="nomic-embed-text"

# OpenAI - opção externa e paga
# Nunca coloque uma chave real neste arquivo.
OPENAI_API_KEY="substitua-pela-sua-chave-no-arquivo-env"
OPENAI_CHAT_MODEL="gpt-5-mini"
OPENAI_EMBEDDING_MODEL="text-embedding-3-small"

# PostgreSQL com pgvector
DATABASE_URL=postgresql+psycopg://cardioassist:cardioassist@localhost:5432/cardioassist

# RAG
RAG_TOP_K=4

# LangSmith - opcional no início
LANGSMITH_TRACING=false
LANGSMITH_API_KEY="substitua-pela-sua-chave-no-arquivo-env"
LANGSMITH_PROJECT="cardioassist-ai"

# Segurança do protótipo
USE_SYNTHETIC_DATA_ONLY=true
REQUIRE_HUMAN_REVIEW=true
